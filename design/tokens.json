{
  "name": "Voxel",
  "version": 1,
  "source": "Conclave Design System v2 (dark theme), read 2026-11-17, plus the Voxel-only tokens at the end.",
  "theme": "dark",
  "color": {
    "ground": "#131a22",
    "surface": "#1b232c",
    "surface-raised": "#242d37",
    "surface-sunken": "#0e131a",
    "line": "#37414b",
    "line-strong": "#6f7c8a",
    "line-hover": "#4c5764",
    "ink": "#edf0f4",
    "ink-muted": "#b7bfc8",
    "ink-faint": "#979faa",
    "signal": "#34c8fd",
    "signal-ink": "#4bcefd",
    "on-signal": "#04111c",
    "signal-soft": "rgba(52, 200, 253, 0.16)",
    "ok": "#4dd7a4",
    "warn": "#f4c352",
    "danger": "#fd736d",
    "scrim": "rgba(4, 8, 12, 0.66)",
    "image-ground": "#000000",
    "plane-axial": "#34c8fd",
    "plane-sagittal": "#ff9d5c",
    "plane-coronal": "#c9a2ff",
    "glass": "rgba(27, 35, 44, 0.92)"
  },
  "font": {
    "display": "Archivo, width 88, weight 700",
    "sans": "IBM Plex Sans, weights 400 and 600",
    "mono": "IBM Plex Mono, weights 400 and 500, slashed zero, tabular figures"
  },
  "type": {
    "display-xl": {"font": "display", "size": 40, "line": 44},
    "display": {"font": "display", "size": 28, "line": 34},
    "title": {"font": "display", "size": 20, "line": 26, "weight": 600},
    "heading": {"font": "sans", "size": 15, "line": 22, "weight": 600},
    "body": {"font": "sans", "size": 14, "line": 21, "weight": 400},
    "body-strong": {"font": "sans", "size": 14, "line": 21, "weight": 600},
    "small": {"font": "sans", "size": 13, "line": 18, "weight": 400},
    "label": {"font": "sans", "size": 11, "line": 14, "weight": 600, "tracking": "0.08em", "case": "upper"},
    "figure": {"font": "mono", "size": 22, "line": 26, "weight": 500},
    "data": {"font": "mono", "size": 13, "line": 18, "weight": 400},
    "overlay": {"font": "mono", "size": 12, "line": 17, "weight": 400},
    "micro": {"font": "mono", "size": 11, "line": 14, "weight": 500, "tracking": "0.04em"}
  },
  "space": {"1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48},
  "radius": {"xs": 3, "sm": 6, "md": 10, "lg": 16, "pill": 999},
  "size": {"control": 34, "touch": 44, "window-min": [1024, 640], "reference-window": [1440, 900]},
  "shadow": {
    "elevation-1": "inset 0 1px 0 rgba(255,255,255,0.04), 0 1px 2px rgba(0,0,0,0.30)",
    "elevation-2": "0 12px 32px rgba(0,0,0,0.45)"
  }
}
